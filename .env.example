# Example environment variables for Task & Focus Manager backend

# Required
MONGO_URI=mongodb://localhost:27017/taskfocus
JWT_SECRET=jwt_secret

# Optional / Feature Flags
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/auth-callback

# Facebook OAuth
FACEBOOK_APP_ID=facebook_app_id
FACEBOOK_APP_SECRET=facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5173/auth-callback

# GitHub OAuth
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5173/auth-callback

# Email (Nodemailer)
EMAIL_USER=email@gmail.com
EMAIL_PASS=gmail_app_password

# Reminders
REMINDER_NO_DUE_DAYS=1

# Frontend redirect
FRONTEND_URL=http://localhost:5173
